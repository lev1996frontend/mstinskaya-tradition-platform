POSTGRES_DB=mstina
POSTGRES_USER=mstina
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://mstina:change_me@postgres:5432/mstina
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The app refuses to start with the built-in placeholder secret once APP_ENV
# is anything other than development/test — generate a real one for staging
# and production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
JWT_SECRET_KEY=change-me-super-secret-key
# Leave unset to auto-derive from APP_ENV (off in development/test, on
# otherwise). Auth cookies need Secure once the app runs over HTTPS, which a
# real deployment always should.
# COOKIE_SECURE=true
